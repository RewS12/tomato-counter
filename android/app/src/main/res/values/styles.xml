<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.Tomato.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Tomato.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/blue_soft</item>
    </style>

    <style name="Widget.Tomato.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Tomato.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="rippleColor">@color/blue_soft</item>
    </style>

    <style name="TextAppearance.Tomato.Kicker" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <style name="TextAppearance.Tomato.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <style name="TextAppearance.Tomato.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Tomato.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Tomato.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
