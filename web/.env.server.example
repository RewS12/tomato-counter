# Copy to .env and SET A LONG RANDOM PASSWORD before docker compose up.
AGROVISION_BASIC_USER=agroadmin
AGROVISION_BASIC_PASSWORD=CHANGE-THIS-TO-A-UNIQUE-24-CHARACTER-SECRET
AGROVISION_PORT=8000
# Keep false until you have specialized tomato weights in models/tomato_best.pt
AGROVISION_INSTALL_AI=false
AGROVISION_DETECTOR=opencv
AGROVISION_YOLO_WEIGHTS=models/tomato_best.pt
AGROVISION_YOLO_CONF=0.30
# Only if publishing via Caddy with valid DNS name:
AGROVISION_DOMAIN=example.org
